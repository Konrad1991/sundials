Package: sundials
Type: Package
Title: Vendored 'SUNDIALS' Solver Suite for Linking by Other Packages
Version: 7.9.0-1
Date: 2026-09-08
Authors@R: c(
    person("Krämer", "Konrad", role = c("aut", "cre"),
           email = "konrad_kraemer@yahoo.de"),
    person("Lawrence Livermore National Security", role = "cph",
           comment = "SUNDIALS source code"),
    person("Southern Methodist University", role = "cph",
           comment = "SUNDIALS source code"),
    person("University of Maryland Baltimore County", role = "cph",
